{
    "name": "@maxpaulus/pi-rex-agents",
    "version": "0.2.2",
    "type": "module",
    "description": "Named pi subagents in Rex panes: splits, floating panes, or other Rex hosts.",
    "license": "MIT",
    "keywords": [
        "pi-package",
        "pi",
        "rex",
        "subagents"
    ],
    "files": [
        "index.ts",
        "agents"
    ],
    "pi": {
        "extensions": [
            "./index.ts"
        ]
    },
    "scripts": {
        "test": "node --experimental-strip-types --test test.mjs",
        "check": "tsc --noEmit --strict --skipLibCheck --target es2022 --module nodenext --moduleResolution nodenext index.ts"
    },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "typescript": "^5.9.3"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/maxpaulus43/pi-rex-agents"
    }
}
