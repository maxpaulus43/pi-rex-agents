{
  "name": "@maxpaulus/pi-rex-agents",
  "version": "0.1.0",
  "type": "module",
  "description": "Named pi subagents in Rex panes: splits, floating panes, or other Rex hosts.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "rex",
    "subagents"
  ],
  "files": [
    "index.ts",
    "agents"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test.mjs",
